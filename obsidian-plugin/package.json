{
	"name": "memex-obsidian-plugin",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin that searches a memex semantic index.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types src/*.test.ts"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"esbuild": "^0.28.2",
		"obsidian": "^1.13.1",
		"typescript": "^7.0.2"
	}
}
